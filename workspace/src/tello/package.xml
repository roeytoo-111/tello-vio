<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tello</name>
  <version>0.0.1</version>
  <description>Package to control DJI tello drones, provides data and control over the drone based on the official SDK provided by DJI.</description>
  <maintainer email="tentone@outlook.com">tentone</maintainer>
  <license>MIT</license>

  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <!--
    This package defines no messages. It previously declared
    rosidl_default_generators and joined rosidl_interface_packages, which tells
    the build system to run the IDL generator over a package with no .msg
    files: pure overhead, and misleading to anyone reading the manifest.
    The messages live in tello_msg, which is depended on below.
  -->
  <depend>tello_msg</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
