// Project AirSim scene config for Tier C (verified key names from
// iamaisim/ProjectAirSim docs/config_scene.md, 2026-09-17). Place the
// packaged environment's own env actors as needed; this file declares the
// follower drone and the target as an env actor whose mesh is a
// Tello-scale model.
{
  "id": "SceneChase",
  "actors": [
    {
      "type": "robot",
      "name": "Follower",
      "origin": { "xyz": "0 0 -1.0", "rpy-deg": "0 0 0" },
      "robot-config": "robot_follower.jsonc"
    },
    {
      "type": "env_actor",
      "name": "TargetTello",
      "origin": { "xyz": "2.0 0 -1.0", "rpy-deg": "0 0 0" }
      // mesh/scale come from the environment's asset registry; a
      // 0.098 x 0.098 x 0.041 m drone mesh, per the real airframe.
    }
  ],
  "clock": { "type": "steppable", "step-ns": 3000000 },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
