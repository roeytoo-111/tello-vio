// Project AirSim scene for Tier C. The follower is a full robot (robot_follower.jsonc).
// The target is not declared here: engine.py spawns it at runtime as a static,
// scaled mesh named "TargetTello", so it stays exactly where it is teleported
// (environment actors re-apply their own trajectory pose on every tick).
{
  "id": "SceneChase",
  "actors": [
    {
      "type": "robot",
      "name": "Follower",
      "origin": { "xyz": "0 0 -1.0", "rpy-deg": "0 0 0" },
      "robot-config": "robot_follower.jsonc"
    }
  ],
  "clock": {
    "type": "steppable",
    "step-ns": 3000000,
    "real-time-update-rate": 3000000,
    "pause-on-start": false
  },
  "home-geo-point": { "latitude": 47.641468, "longitude": -122.140165, "altitude": 122.0 },
  "segmentation": {
    "initialize-ids": true,
    "ignore-existing": false,
    "use-owner-name": true
  },
  "scene-type": "UnrealNative"
}
