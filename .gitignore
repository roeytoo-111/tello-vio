# ---------------------------------------------------------------------------
# colcon build artifacts.
#
# These were previously committed (build/, install/ and log/ held ~1000 files,
# including absolute paths from whoever built last and --symlink-install
# symlinks). That makes every build show up as a huge diff and makes the tree
# unusable on another machine: a stale CMakeCache.txt pointing at a different
# source directory aborts the build outright.
# ---------------------------------------------------------------------------
/build/
/install/
/log/
workspace/build/
workspace/install/
workspace/log/
slam/build/
slam/install/
slam/log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Calibration output written into the working directory by the calib nodes
imu_calibration.yaml
camera_imu_calibration.yaml
KeyFrameTrajectory.txt

# Third-party sources fetched by scripts/orbslam.sh
libs/ORB_SLAM2/
libs/Pangolin/
libs/g2o/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Recorded bags
*.db3
rosbag2_*/

# chase_detector runtime output (per-frame CSVs, captured training frames)
chase_logs/
chase_dataset/

# Detector weights and training-run outputs (checkpoints, metrics, ONNX)
yolov8n.pt
runs/

# Project AirSim client writes this next to the CWD
projectairsim_client.log

# Tier C detector + eval outputs (weights, debug frames, snapshots)
detector_runs/
chase_frames*/
yolo_view/
warehouse_view.png
vision_in_loop_result.json
yolo26*.pt
